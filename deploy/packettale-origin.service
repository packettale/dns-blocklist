[Unit]
Description=packettale blocklist website and feeds
After=network-online.target packettale-firewall.service
Wants=network-online.target

[Service]
Type=simple
User=blocklist-web
Group=blocklist-public
WorkingDirectory=/opt/dns-ip-blocklist
Environment=HOST=127.0.0.1
Environment=PORT=80
Environment=PUBLIC_HOSTNAME=blocklist.packettale.com
Environment=REQUIRE_HTTPS=true
Environment=FEED_MIN_REFRESH_SECONDS=300
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/opt/dns-ip-blocklist-runtime/bin/node /opt/dns-ip-blocklist/src/origin.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/etc/dns-ip-blocklist /opt/dns-ip-blocklist/reports
UMask=0027
MemoryMax=192M
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
